{
  "name": "discord-multifunction-bot-system",
  "version": "1.0.0",
  "description": "Sistema completo de bot multifuncional para Discord com API backend, painel web React e banco SQLite",
  "main": "bot/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --experimental-sqlite scripts/start-dev.js",
    "build": "npm --prefix web install && npm --prefix web run build",
    "dev": "node --experimental-sqlite scripts/start-dev.js",
    "bot": "node --experimental-sqlite bot/index.js",
    "api": "node --experimental-sqlite api/index.js",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "db:migrate": "node --experimental-sqlite database/migrate.js",
    "db:backup": "node --experimental-sqlite scripts/backup.js",
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/**/*.test.js",
    "test:integration": "node --test tests/integration/**/*.test.js",
    "test:security": "node --test tests/security/**/*.test.js",
    "test:recovery": "node --test tests/recovery/**/*.test.js"
  },
  "keywords": [
    "discord-bot",
    "discordjs",
    "moderation",
    "dashboard",
    "sqlite",
    "rbac"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@napi-rs/canvas": "^1.0.13",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "qrcode": "^1.5.4"
  }
}
