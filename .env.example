# ==========================================
# CONFIGURAÇÕES DO BOT DISCORD MULTIFUNCIONAL
# ==========================================

# Identidade e Controle Global
GLOBAL_OWNER_ID=123456789012345678
DEFAULT_PREFIX=?
BOT_NAME="Bot Multifuncional"
NODE_ENV=development

# Credenciais do Discord Bot
# Obtenha em: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=seu_token_do_bot_aqui
DISCORD_CLIENT_ID=seu_client_id_aqui
DISCORD_CLIENT_SECRET=seu_client_secret_aqui

# Intents Requeridos no Discord Developer Portal:
# - Guilds
# - Guild Members (Privileged Gateway Intent)
# - Guild Moderation / Guild Bans
# - Guild Messages
# - Message Content (Privileged Gateway Intent - OBRIGATÓRIO PARA COMANDOS POR PREFIXO '?')
# - Direct Messages

# Configurações da API Backend
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=defina_uma_chave_secreta_longa_e_aleatoria_para_assinatura_de_sessoes_min_32_chars
COOKIE_SECURE=false

# Configurações do OAuth2 Discord
DISCORD_OAUTH_REDIRECT_URI=http://localhost:3001/api/auth/callback
DISCORD_OAUTH_SCOPES=identify guilds

# Configurações do Frontend Web
VITE_API_URL=http://localhost:3001

# Banco de Dados SQLite
SQLITE_DB_PATH=./database/storage.sqlite

# Política de Retenção e Backups
AUDIT_LOG_RETENTION_DAYS=90
TRANSCRIPT_STORAGE_PATH=./transcripts
BACKUP_STORAGE_PATH=./backups
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COPIES=7
